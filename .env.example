# Keep the production values only in /etc/channel-reposter.env (permissions 600).
PORT=3015
PUBLIC_BASE_URL=https://channel.xedoc.ru
APP_ENCRYPTION_KEY=

# Telegram bot settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-value
TELEGRAM_SOURCE_CHANNEL_USERNAME=losvprode

# MAX bot settings
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=replace-with-a-different-long-random-value

# Usually empty. It is filled automatically after the MAX bot is re-added to the target channel.
MAX_TARGET_CHAT_ID=

# Optional payment provider. Set both values only in /etc/channel-reposter.env.
# In the YooKassa dashboard, configure notification URL:
# https://channel.xedoc.ru/webhooks/yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
