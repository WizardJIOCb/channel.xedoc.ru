[Unit]
Description=Channel Xedoc Telegram to MAX reposter
After=network-online.target telegram-bot-api.service
Wants=network-online.target telegram-bot-api.service

[Service]
Type=simple
User=channel-reposter
Group=channel-reposter
WorkingDirectory=/var/www/channel.xedoc.ru
EnvironmentFile=/etc/channel-reposter.env
Environment=STATE_PATH=/var/lib/channel-reposter/app.json
Environment=TELEGRAM_LOCAL_API_URL=http://127.0.0.1:8081
Environment=TELEGRAM_LOCAL_SOURCES=anytin_sadik
Environment=TELEGRAM_LOCAL_FILE_ROOT=/var/lib/telegram-bot-api
ExecStart=/usr/bin/node /var/www/channel.xedoc.ru/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/channel-reposter
ReadOnlyPaths=/var/lib/telegram-bot-api

[Install]
WantedBy=multi-user.target
